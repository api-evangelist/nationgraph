          "id": "df62e785-79e9-484d-85c7-9ebd4900e9dd",
          "name": "List Owners",
          "request": {
            "name": "List Owners",
            "description": {
              "content": "Get a paginated list of owners from the CRM.\n\nOwners are users in your CRM account who can be assigned to CRM records\n(contacts, companies, deals, tasks, etc.). Use this endpoint to populate\nowner dropdowns in your UI for assignment purposes.\n\n**Pagination:**\nUse the `nextCursor` value in subsequent requests to fetch more results.\n\n**Filtering:**\n- Use `email` to find a specific owner by email address\n- Use `archived` to include archived (deactivated) owners",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "crm",
                ":integration_id",
                "owners"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of results per page (max 100)"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Pagination cursor"
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "Filter by email address (exact match)"
                },
                {
                  "disabled": false,
                  "key": "archived",
                  "value": "false",
                  "description": "Include archived owners"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "integration_id",
                  "description": "(Required) The CRM integration ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
