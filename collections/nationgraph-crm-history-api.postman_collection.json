          "name": "Get Non-Automation CRM Activity for an Integration",
          "request": {
            "name": "Get Non-Automation CRM Activity for an Integration",
            "description": {
              "content": "Paginated history of non-automation CRM activity for this integration.\n\nReturns every row in `crm_actions` for the integration's organization and\nCRM provider — link/note/task/post/contact_push — joined with institution\nnames.  Ordered by `created_at` descending.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "crm",
                ":integration_id",
                "activity"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "integration_id",
                  "description": "(Required) The CRM integration ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
