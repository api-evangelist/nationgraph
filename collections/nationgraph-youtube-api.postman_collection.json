        {
          "id": "20e9bc29-5c60-4c40-9e08-72c6f85ded99",
          "name": "Search Youtube",
          "request": {
            "name": "Search Youtube",
            "description": {
              "content": "Search YouTube caption chunks.\n\nInstitution linkage is dual-route — chunks are matched if EITHER the\nvideo's channel is mapped to the institution (via youtube_links) OR the\nvideo itself carries a per-video tag (raw.video_institution_unique_id).\nResults from both routes are unioned and deduped, preferring the\nper-video tag when both routes match the same chunk.\n\nThe ``query`` field uses ``websearch_to_tsquery('english', ...)`` —\nwebsearch syntax (quoted phrases, OR, leading - to exclude). For tight\nphrase matching, quote the phrase. Cover-density ranking (ts_rank_cd)\nalready favors chunks where query terms appear close together.\n\nAt least one of ``institution_ids`` or ``query`` is required.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "internal",
                "youtube",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"<string>\",\n  \"institution_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"states\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"source_tables\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"date_after\": \"<date>\",\n  \"date_before\": \"<date>\",\n  \"group_by_document\": false,\n  \"offset\": 0,\n  \"limit\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
