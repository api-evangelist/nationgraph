                "value": "",
                "type": "path",
                "description": "The CRM integration ID"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Text search across searchable properties"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by company name"
              },
              {
                "name": "domain",
