        {
          "id": "982c2a96-0e34-4791-b2b9-6274cdd40fe4",
          "name": "Get Enrichment Stats",
          "request": {
            "name": "Get Enrichment Stats",
            "description": {
              "content": "Get status-bucketed counts of enrichments for the authenticated user.\nRows with NULL status are bucketed under `\"unknown\"`. Respects the same\n`institution_ids` filter as GET /enrichments, so pill counts stay in sync\nwhen an institution filter is active. Status is deliberately not a filter\nhere — stats is the source of the pill counts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "enrichments",
                "stats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
