{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nationgraph Accounts Views API",
    "version": "0.2.36"
  },
  "items": [
    {
      "info": {
        "name": "Views",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Views",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v3/views",
            "params": [
              {
                "name": "view_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "resource_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List the authenticated user's saved views, optionally scoped by type/resource."
        },
        {
          "info": {
            "name": "Create View",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v3/views",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a saved view for the authenticated user."
        },
        {
          "info": {
            "name": "Get View",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v3/views/:view_id",
            "params": [
              {
                "name": "view_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a single saved view by id."
        },
        {
          "info": {
            "name": "Update View",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v3/views/:view_id",
            "params": [
              {
                "name": "view_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a saved view's name and/or filters."
        },
        {
          "info": {
            "name": "Delete View",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v3/views/:view_id",
            "params": [
              {
                "name": "view_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a saved view."
        }
      ]
    }
  ],
  "bundled": true
}